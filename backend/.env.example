# OneMeet Backend Environment Configuration
# Copy this file to .env in backend/ or root directory.

SECRET_KEY=django-insecure-onemeet-dev-key-change-in-production-1234567890
DEBUG=True

# Allowed Hosts (Comma separated)
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1,*

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (SQLite dev fallback / PostgreSQL for production)
DATABASE_URL=sqlite:///db.sqlite3

# Redis Channel Layer Configuration (Set USE_REDIS=True if using Redis)
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=False

# STUN / TURN Server Configuration for WebRTC
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Email & OTP Authentication Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OneMeet Security <your_email@gmail.com>
OTP_EXPIRY_MINUTES=10

