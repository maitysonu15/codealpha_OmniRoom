# OmniRoom Environment Configuration Template
# Copy this file to .env and fill in your private credentials.
# NEVER commit your actual .env file to version control.

# Django Security Key & Debug Mode
SECRET_KEY=your-super-secret-django-key-replace-in-production
DEBUG=False

# Allowed Hosts (Comma separated)
ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# CORS & CSRF Settings for Frontend & Vercel
CORS_ALLOWED_ORIGINS=https://your-domain.vercel.app,http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=https://your-domain.vercel.app,http://localhost:8080,http://127.0.0.1:8080

# Database Configuration (SQLite by default in dev, or PostgreSQL in production)
# Example PostgreSQL: postgresql://user:password@hostname:5432/omniroom_db
DATABASE_URL=sqlite:///db.sqlite3

# Redis Channel Layer Configuration (For real-time WebSockets via Django Channels)
REDIS_URL=redis://127.0.0.1:6379/0
USE_REDIS=False

# STUN / TURN Server Configuration for WebRTC Video Streaming
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=

# Email & OTP Verification Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=OmniRoom Security <your_email@gmail.com>
OTP_EXPIRY_MINUTES=10

# Brevo (Sendinblue) Transactional Email API (Optional)
BREVO_API_KEY=your_brevo_api_key_here

# ==============================================================================
# Firebase Web App Configuration (Loaded securely from .env)
# ==============================================================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
